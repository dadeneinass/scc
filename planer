  var end = document.getElementById("sm-end").value || "12:15";

  if (activeProgramSlotId) {
    var sl = st.programs.find(function(p){ return p.id === activeProgramSlotId; });
    if (sl) {
      sl.text = text;
      sl.start = start;
      sl.end = end;
    }
  } else {
    st.programs.push({
      id: Date.now(),
      text: text,
      start: start,
      end: end
    });
  }

  persist();
  closeStageModal();
  render();
}

function deleteStageModal() {
  var st = appData.stages.find(function(s){ return s.id === activeStageId; });
  if (st && activeProgramSlotId) {
    st.programs = st.programs.filter(function(p){ return p.id !== activeProgramSlotId; });
    persist();
  }
  closeStageModal();
  render();
}

function openCoversModal() {
  var box = document.getElementById("covers-list-box");
  box.innerHTML = "";

  appData.covers.forEach(function(c, i) {
    var row = document.createElement("div");
    row.className = "modal-row";
    row.innerHTML = 
      '<input type="color" value="' + (c.color||"#0284c7") + '" id="cov-col-' + i + '" style="width:36px; padding:0; height:30px; cursor:pointer;" title="Farbe">' +
      '<input type="text" value="' + c.name + '" id="cov-name-' + i + '" style="flex:2;" placeholder="Name">' +
      '<input type="time" value="' + (c.start||"10:30") + '" id="cov-start-' + i + '" style="flex:1;" title="Dienstbeginn">' +
      '<input type="time" value="' + (c.end||"14:30") + '" id="cov-end-' + i + '" style="flex:1;" title="Feierabend">' +
      '<button type="button" style="color:var(--danger); background:transparent; padding:4px;" onclick="removeCoverMember(' + i + ')">✕</button>';
    box.appendChild(row);
  });

  document.getElementById("covers-modal").style.display = "flex";
}

function closeCoversModal() { document.getElementById("covers-modal").style.display = "none"; }

function addCoverMember() {
  var defaultColors = ["#0284c7", "#9333ea", "#ea580c", "#10b981", "#ec4899", "#f59e0b", "#64748b"];
  var nextCol = defaultColors[appData.covers.length % defaultColors.length];
  appData.covers.push({
    id: Date.now(),
    name: "Neuer Springer",
    start: "10:30",
    end: "14:30",
    color: nextCol
  });
  openCoversModal();
}

function removeCoverMember(idx) {
  if (confirm("Springer '" + appData.covers[idx].name + "' wirklich entfernen?")) {
    appData.covers.splice(idx, 1);
    openCoversModal();
  }
}

function saveCoversModal() {
  appData.covers.forEach(function(c, i) {
    var n = document.getElementById("cov-name-" + i).value.trim();
    var s = document.getElementById("cov-start-" + i).value;
    var e = document.getElementById("cov-end-" + i).value;
    var col = document.getElementById("cov-col-" + i).value;
    if (n) c.name = n;
    if (s) c.start = s;
    if (e) c.end = e;
    if (col) c.color = col;
  });
  persist();
  closeCoversModal();
  render();
}

function openTeamModal() {
  var box = document.getElementById("team-edit-box");
  box.innerHTML = "";

  appData.people.forEach(function(p, i) {
    var row = document.createElement("div");
    row.className = "modal-row";
    row.innerHTML = 
      '<input type="text" value="' + p.name + '" id="tm-name-' + i + '" style="flex:2;">' +
      '<input type="text" value="' + p.desc + '" id="tm-desc-' + i + '" style="flex:2.5;">' +
      '<button type="button" style="color:var(--danger); background:transparent;" onclick="removeTeamMember(' + i + ')">✕</button>';
    box.appendChild(row);
  });

  document.getElementById("team-modal").style.display = "flex";
}

function closeTeamModal() { document.getElementById("team-modal").style.display = "none"; }

function addTeamMember() {
  var name = prompt("Name der neuen Person:", "Neue Person");
  if (!name) return;
  var desc = prompt("Station / Position:", "Infocounter");
  appData.people.push({
    id: Date.now(),
    name: name.trim(),
    desc: desc ? desc.trim() : "Infocounter",
    group: "Infocounter",
    sStart: "08:00",
    sEnd: "17:00",
    p: null
  });
  openTeamModal();
}

function removeTeamMember(idx) {
  if (confirm("Person wirklich aus der Liste löschen?")) {
    appData.people.splice(idx, 1);
    openTeamModal();
  }
}

function saveTeamModal() {
  appData.people.forEach(function(p, i) {
    var n = document.getElementById("tm-name-" + i);
    var d = document.getElementById("tm-desc-" + i);
    if (n && n.value.trim()) p.name = n.value.trim();
    if (d && d.value.trim()) p.desc = d.value.trim();
  });
  persist();
  closeTeamModal();
  render();
}

render();
setInterval(function() {
  render();
}, 60000);
</script>
</body>
</html>
