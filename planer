function render() {
  var range = getDynamicRange();
  renderTicks(range);

  var allBreaks = [];
  appData.people.forEach(function(p) {
    if (p.p) {
      var s = toM(p.p.start);
      allBreaks.push({
        pId: p.id,
        pName: p.name,
        desc: p.desc,
        group: p.group,
        start: s,
        dur: p.p.dur,
        end: s + p.p.dur,
        cover: p.p.cover || "Unbekannt"
      });
    }
  });

  var conflictPIds = new Set();
  var wegzeitDangerPIds = new Set();
  var wegzeitWarnPIds = new Set();
  var overtimeInfo = {};

  allBreaks.sort(function(a, b){ return a.start - b.start; });

  // 1. Feierabend & Dienstbeginn
  allBreaks.forEach(function(b) {
    var covObj = appData.covers.find(function(c){ return c.name === b.cover; });
    if (covObj && covObj.end && covObj.start) {
      var sEnd = toM(covObj.end);
      var sStart = toM(covObj.start);
      if (b.end > sEnd) {
        overtimeInfo[b.pId] = "FEIERABEND (" + covObj.end + ")";
      } else if (b.start < sStart) {
        overtimeInfo[b.pId] = "VOR DIENST (" + covObj.start + ")";
      }
    }
  });

  // 2. Konflikt- und Wegzeit-Prüfung
  for (var i = 0; i < allBreaks.length; i++) {
    for (var j = i + 1; j < allBreaks.length; j++) {
      var b1 = allBreaks[i];
      var b2 = allBreaks[j];
      
      // Nur echte Springer auf Wegzeit und Doppelbelegung prüfen (Partner/Teamintern vertritt unabhängig)
      var isCoverSpringer = appData.covers.some(function(c){ return c.name === b1.cover; });
      if (isCoverSpringer && b1.cover === b2.cover) {
        if (b1.start < b2.end && b2.start < b1.end) {
          conflictPIds.add(b1.pId);
          conflictPIds.add(b2.pId);
        } else {
          var gap = b2.start - b1.end;
          if (gap >= 0 && gap < 10) {
            wegzeitDangerPIds.add(b1.pId);
            wegzeitDangerPIds.add(b2.pId);
          } else if (gap >= 10 && gap < 15) {
            wegzeitWarnPIds.add(b1.pId);
            wegzeitWarnPIds.add(b2.pId);
          }
        }
      }
    }
  }

  // Springer Auslastungs-Legende
  var covMinutes = {};
  allBreaks.forEach(function(b){ covMinutes[b.cover] = (covMinutes[b.cover] || 0) + b.dur; });

  var leg = document.getElementById("legend-box");
  leg.innerHTML = "<span style='color:var(--muted); font-weight:bold;'>Springer Auslastung:</span>";
  appData.covers.forEach(function(c) {
    var m = covMinutes[c.name] || 0;
    leg.innerHTML += "<span class='badge-cov' style='background:" + c.color + "'>" + c.name.split(" ")[0] + " (" + (c.start||"10:30") + "-" + (c.end||"14:30") + " | " + m + "m)</span>";
  });

  var gBody = document.getElementById("gantt-body");
  gBody.innerHTML = "";

  var nowM = getCurrentMinutes();
  var isNowVisible = (nowM >= range.start && nowM <= range.end);
  var nowPct = isNowVisible ? (((nowM - range.start) / range.total) * 100) : null;

  // RENDERN DER LOGISCHEN BEREICHE
  var sections = [
    { title: "🏢 Infocounter", filter: function(p){ return p.group === "Infocounter"; } },
    { title: "🎙️ Stages & Bühnen-Teams", isStageContainer: true },
    { title: "🧭 Extras & Wegeleitung", filter: function(p){ return p.group === "Extras & Wegeleitung"; } }
  ];

  sections.forEach(function(sec) {
    if (sec.isStageContainer) {
      // HAUPT-HEADER STAGES
      var head = document.createElement("div");
      head.className = "group-header";
      head.innerHTML = "<span>" + sec.title + "</span><span style='font-size:0.7rem; color:var(--muted); font-weight:normal;'>Klicke auf die Stage-Leiste, um Vortragszeiten hinzuzufügen</span>";
      gBody.appendChild(head);

      // FÜR JEDE STAGE EIGENER SUBHEADER MIT VORTRAGSTRACK
      appData.stages.forEach(function(stage) {
        var subHeader = document.createElement("div");
        subHeader.className = "stage-sub-header";
        
        var titleSpan = document.createElement("span");
        titleSpan.innerHTML = "🎤 <b>" + stage.name + "</b>";
        subHeader.appendChild(titleSpan);

        // Vortrags-Leiste
        var progTrack = document.createElement("div");
        progTrack.className = "stage-prog-bar-container";
        progTrack.title = "Klicken, um neuen Programmslot hinzuzufügen";
        progTrack.onclick = function(e) {
          if (e.target === progTrack) openStageModal(stage.id, null);
        };

        stage.programs.forEach(function(slot) {
          var sM = toM(slot.start);
          var eM = toM(slot.end);
          var sPct = Math.max(0, ((sM - range.start) / range.total) * 100);
          var wPct = Math.max(2, (((eM - sM) / range.total) * 100));

          var bSlot = document.createElement("div");
          bSlot.className = "stage-slot-badge";
          bSlot.style.left = sPct + "%";
          bSlot.style.width = wPct + "%";
          bSlot.innerText = slot.start + "-" + slot.end + ": " + slot.text;
          bSlot.onclick = function(ev) {
            ev.stopPropagation();
            openStageModal(stage.id, slot.id);
          };
          progTrack.appendChild(bSlot);
        });

        subHeader.appendChild(progTrack);

        var addBtn = document.createElement("button");
        addBtn.style.padding = "2px 8px";
        addBtn.style.marginLeft = "8px";
        addBtn.style.fontSize = "0.7rem";
        addBtn.style.background = "#243354";
        addBtn.style.color = "#f59e0b";
        addBtn.innerText = "+ Vortrag";
        addBtn.onclick = function(){ openStageModal(stage.id, null); };
        subHeader.appendChild(addBtn);

        gBody.appendChild(subHeader);

        // PERSONEN DER JEWEILIGEN STAGE
        var stagePeople = appData.people.filter(function(p){ return p.group === stage.id; });
        stagePeople.forEach(function(p){ renderPersonRow(p, gBody, allBreaks, range, isNowVisible, nowPct, conflictPIds, overtimeInfo, wegzeitDangerPIds, wegzeitWarnPIds); });
      });

    } else {
      var peopleInSec = appData.people.filter(sec.filter);
      if (peopleInSec.length === 0) return;

      var secHead = document.createElement("div");
      secHead.className = "group-header";
      secHead.innerText = sec.title + " (" + peopleInSec.length + " Personen)";
      gBody.appendChild(secHead);

      peopleInSec.forEach(function(p){ renderPersonRow(p, gBody, allBreaks, range, isNowVisible, nowPct, conflictPIds, overtimeInfo, wegzeitDangerPIds, wegzeitWarnPIds); });
    }
  });

  // Jetzt-Badge auf Timeline
  var oldBadge = document.getElementById("now-badge-el");
  if (oldBadge) oldBadge.remove();
  if (isNowVisible && nowPct !== null) {
    var headEl = document.getElementById("timeline-ticks");
    var badge = document.createElement("div");
    badge.id = "now-badge-el";
    badge.className = "now-indicator-badge";
    badge.style.left = nowPct + "%";
    badge.innerText = "JETZT " + toTimeStr(nowM);
    headEl.appendChild(badge);
  }

  renderTable();
}

function renderPersonRow(p, container, allBreaks, range, isNowVisible, nowPct, conflictPIds, overtimeInfo, wegzeitDangerPIds, wegzeitWarnPIds) {
  var row = document.createElement("div");
  row.className = "gantt-row";

  var meta = document.createElement("div");
  meta.className = "row-meta";
  meta.innerHTML = "<div><div class='row-name'>" + p.name + "</div><div class='row-sub'>" + p.desc + "</div></div>";
  row.appendChild(meta);

  var track = document.createElement("div");
  track.className = "row-track";

  if (isNowVisible && nowPct !== null) {
    var nowLine = document.createElement("div");
    nowLine.className = "now-indicator-line";
    nowLine.style.left = nowPct + "%";
    track.appendChild(nowLine);
  }

  var b = allBreaks.find(function(x){ return x.pId === p.id; });
  if (b) {
    var isConflict = conflictPIds.has(p.id);
    var isOvertime = overtimeInfo[p.id];
    var isWegzeitDanger = wegzeitDangerPIds.has(p.id) && !isConflict;
    var isWegzeitWarn = wegzeitWarnPIds.has(p.id) && !isConflict && !isWegzeitDanger;

    var covObj = appData.covers.find(function(c){ return c.name === b.cover; });
    var color = covObj ? covObj.color : "#475569";

    var bar = document.createElement("div");
    var warnClasses = "";
    var labelPrefix = "";

    if (isConflict) {
      warnClasses = "bar-conflict";
      labelPrefix = "⚠️ DOPPELBELEGUNG: ";
    } else if (isOvertime) {
      warnClasses = "bar-overtime";
      labelPrefix = "⚠️ " + isOvertime + ": ";
    } else if (isWegzeitDanger) {
      warnClasses = "bar-wegzeit-danger";
      labelPrefix = "⚠️ Wegzeit <10m: ";
    } else if (isWegzeitWarn) {
      warnClasses = "bar-wegzeit-warn";
      labelPrefix = "";
    }

    bar.className = "bar " + warnClasses;
    bar.style.left = Math.max(0, ((b.start - range.start) / range.total) * 100) + "%";
    bar.style.width = ((b.dur / range.total) * 100) + "%";
    bar.style.background = color;
    bar.innerText = labelPrefix + b.cover.split(" ")[0] + " • " + toTimeStr(b.start);

    initDesktopDrag(bar, p.id, track, range);

    bar.onclick = function(e) {
      if (!bar.dataset.dragged) openModal(p.id);
    };

    track.appendChild(bar);
  }

  row.appendChild(track);
  container.appendChild(row);
}

function initDesktopDrag(barEl, personId, trackEl, range) {
  var startX = 0, origLeftPct = 0, isDragging = false;

  barEl.onmousedown = function(e) {
    if (e.button !== 0) return;
    isDragging = true;
    barEl.dataset.dragged = "";
    startX = e.clientX;
    origLeftPct = parseFloat(barEl.style.left) || 0;

    document.onmousemove = function(e) {
      if (!isDragging) return;
      barEl.dataset.dragged = "true";
      var deltaPx = e.clientX - startX;
      var trackWidth = trackEl.clientWidth;
      var deltaPct = (deltaPx / trackWidth) * 100;
      var newPct = Math.max(0, Math.min(100 - parseFloat(barEl.style.width), origLeftPct + deltaPct));
      barEl.style.left = newPct + "%";
    };

    document.onmouseup = function() {
      if (!isDragging) return;
      isDragging = false;
      document.onmousemove = null;
      document.onmouseup = null;

      if (barEl.dataset.dragged === "true") {
        var finalPct = parseFloat(barEl.style.left);
        var currentMins = range.start + (finalPct / 100) * range.total;
        var snappedMins = Math.round(currentMins / 5) * 5; // 5-Minuten Raster
        
        var person = appData.people.find(function(x){ return x.id === personId; });
        if (person && person.p) {
          person.p.start = toTimeStr(snappedMins);
          persist();
          render();
        }
      }
    };
  };
}

