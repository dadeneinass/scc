function toM(str) {
  if (!str) return 0;
  var p = str.split(":");
  return parseInt(p[0], 10) * 60 + parseInt(p[1], 10);
}

function toTimeStr(mins) {
  var h = String(Math.floor(mins / 60)).padStart(2, '0');
  var m = String(mins % 60).padStart(2, '0');
  return h + ":" + m;
}

function getCurrentMinutes() {
  var d = new Date();
  return d.getHours() * 60 + d.getMinutes();
}

function getRequiredBreakDur(sStart, sEnd) {
  var diff = toM(sEnd) - toM(sStart);
  if (diff >= 540) return 60; // ab 9 Std
  if (diff >= 360) return 30; // ab 6 Std
  return 0; // unter 6 Std
}

function getDynamicRange() {
  var starts = [570]; // min. 09:30
  var ends = [930];   // min. 15:30

  var nowM = getCurrentMinutes();
  if (nowM >= 420 && nowM <= 1260) {
    starts.push(nowM);
    ends.push(nowM + 30);
  }

  appData.people.forEach(function(p) {
    if (p.p) {
      var s = toM(p.p.start);
      starts.push(s);
      ends.push(s + (p.p.dur || 60));
    }
  });

  appData.covers.forEach(function(c) {
    if (c.start) starts.push(toM(c.start));
    if (c.end) ends.push(toM(c.end));
  });

  appData.stages.forEach(function(st) {
    st.programs.forEach(function(pr) {
      if (pr.start) starts.push(toM(pr.start));
      if (pr.end) ends.push(toM(pr.end));
    });
  });

  var minM = Math.min.apply(null, starts);
  var maxM = Math.max.apply(null, ends);

  var rStart = Math.max(420, Math.floor(minM / 30) * 30);
  var rEnd = Math.min(1260, Math.ceil(maxM / 30) * 30 + 30);

  return { start: rStart, end: rEnd, total: rEnd - rStart };
}

function renderTicks(range) {
  var el = document.getElementById("timeline-ticks");
  el.innerHTML = "";
  for (var m = range.start; m <= range.end; m += 30) {
    var pct = ((m - range.start) / range.total) * 100;
    var d = document.createElement("div");
    d.className = "tick-label";
    d.style.left = pct + "%";
    d.innerText = toTimeStr(m);
    el.appendChild(d);
  }
}

